---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
---
<Base title="ABC 4 Future / Jobs">
  <PageHead titel="ABC 4 FUTURE" text="Wir bringen Mitglieder, Spieler, Trainer und Eltern mit Unternehmen aus der Region zusammen." />
  <section class="section">
    <div class="wrap row" style="gap:40px;align-items:flex-start">
      <div class="prose" style="flex:2 1 520px">
        <p class="lead">Unsere Partnerunternehmen bieten Ausbildungsplätze, Praxisphasen im dualen Studium, Praktika, Voll- und Teilzeitstellen sowie Ferienjobs.</p>
        <p>Du suchst ein Praktikum, eine Ausbildung oder willst dich beruflich verändern? Oder du bist Unternehmen und suchst Mitarbeitende? Melde dich – wir stellen den Kontakt her.</p>
      </div>
      <aside class="box-rot" style="flex:1 1 280px"><h3>Kontakt</h3><a class="btn btn-hell" href="mailto:info@ahrweilerbc.com?subject=ABC%204%20Future">info@ahrweilerbc.com</a></aside>
    </div>
  </section>
</Base>
