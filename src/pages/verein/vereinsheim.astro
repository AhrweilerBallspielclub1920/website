---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
---
<Base title="Vereinsheim">
  <PageHead titel="VEREINSHEIM" text="Das Jahnheim am Ahrstadion – für Mannschaftsabende, Sitzungen und Feiern." crumbs={[{ href: '/verein/vorstand', label: 'Verein' }]} />
  <section class="section">
    <div class="wrap stack-lg" style="max-width:900px">
      <div class="hinweis"><strong>Belegungsplan:</strong> Hier kann ein Kalender eingebunden werden (z. B. ein freigegebener Google- oder Nextcloud-Kalender). Auf der alten Seite war der Plan leer.</div>
      <p>Anfragen zur Belegung bitte an <a href="mailto:info@ahrweilerbc.com">info@ahrweilerbc.com</a>.</p>
    </div>
  </section>
</Base>
