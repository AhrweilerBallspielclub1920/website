---
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import { getCollection } from 'astro:content';
import { alleNews, kommendeSpiele, wochentag } from '../lib/utils';

const news = await alleNews();
const [top, ...rest] = news.filter((n) => !n.data.angepinnt);
const spiele = (await kommendeSpiele()).slice(0, 4);
const gruppen = (await getCollection('gruppen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const senioren = gruppen.filter((g) => g.data.bereich === 'Senioren');
const jugend = gruppen.filter((g) => g.data.bereich === 'Jugend');
---
<Base>
  <section class="hero">
    <div class="wrap">
      <div class="hero-text">
        <span class="eyebrow">zusammen.immer.abc.</span>
        <h1>RESPEKT.<br />TOLERANZ.<br /><span>LEIDENSCHAFT.</span></h1>
        <p style="font-size:19px;max-width:540px">Fußball im Apollinarisstadion – von den Bambini bis zur 1. Mannschaft. Rund 25 Jugendteams, ein Verein.</p>
        <div class="row">
          <a href="#spieltag" class="btn btn-hell">Nächste Spiele</a>
          <a href="/mitglied-werden" class="btn btn-rahmen">Mitglied werden</a>
        </div>
      </div>
      <div class="hero-bild" style="background:none;border:0"><img src="/wappen-512.webp" alt="Wappen des Ahrweiler BC" width="340" height="340" style="width:min(340px,64vw);height:auto;aspect-ratio:1/1;filter:drop-shadow(0 18px 40px rgba(0,0,0,.35))" /></div>
    </div>
  </section>

  <section class="section section-creme" id="spieltag">
    <div class="wrap stack-lg">
      <div class="row between">
        <div class="stack" style="gap:6px">
          <span class="eyebrow">Spieltag</span>
          <h2>Die nächsten Spiele</h2>
        </div>
        <a href="https://www.fussball.de" rel="noopener" target="_blank">Kompletter Spielplan auf fussball.de →</a>
      </div>
      {spiele.length > 0 ? (
        <div class="grid">
          {spiele.map((s) => (
            <article class="card spiel">
              <div class="zeile"><span>{wochentag(s.datum)}</span><strong style="color:var(--text)">{s.uhrzeit} Uhr</strong></div>
              <span class={s.heim ? 'chip' : 'chip chip-gold'}>{s.team} · {s.heim ? 'Heimspiel' : 'Auswärts'}</span>
              {s.heim
                ? <div class="paarung">Ahrweiler BC<br /><span>vs. {s.gegner}</span></div>
                : <div class="paarung">{s.gegner}<br /><span>vs. Ahrweiler BC</span></div>}
              {s.platz && <span class="small muted">{s.platz}</span>}
            </article>
          ))}
        </div>
      ) : (
        <p class="muted">Aktuell sind keine Spiele eingetragen. Alle Termine findest du auf fussball.de.</p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap stack-lg">
      <div class="row between">
        <div class="stack" style="gap:6px">
          <span class="eyebrow">Aktuelles</span>
          <h2>Vereinsnews</h2>
        </div>
        <a href="/news">Alle News →</a>
      </div>
      <div class="row" style="align-items:flex-start;gap:32px">
        {top && <div style="flex:2 1 520px"><NewsCard eintrag={top} gross /></div>}
        <div style="flex:1 1 320px" class="stack">
          {rest.slice(0, 4).map((n) => (
            <a href={`/news/${n.id}`} class="card-link" style="flex-direction:row;gap:14px;padding-bottom:16px;border-bottom:1px solid var(--linie)">
              <div class="bild-platzhalter" style="flex:0 0 96px;height:72px" aria-hidden="true"></div>
              <div class="stack" style="gap:4px">
                <span class="eyebrow" style="font-size:11px">{n.data.team ?? n.data.kategorie}</span>
                <strong style="line-height:1.3">{n.data.title}</strong>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dunkel">
    <div class="wrap stack-lg">
      <div class="stack" style="gap:6px">
        <span class="eyebrow">Teams</span>
        <h2>Unsere Mannschaften</h2>
      </div>
      <div class="row" style="align-items:flex-start;gap:40px">
        <div class="stack" style="flex:1 1 260px">
          <span class="small" style="color:#D8CFC4;font-weight:600;letter-spacing:.08em">SENIOREN</span>
          <div class="stack" style="gap:10px">
            {senioren.map((g) => <a class="team-kachel" href={`/mannschaften/${g.id}`}><strong>{g.data.name}</strong></a>)}
          </div>
        </div>
        <div class="stack" style="flex:2 1 520px">
          <span class="small" style="color:#D8CFC4;font-weight:600;letter-spacing:.08em">JUGEND</span>
          <div class="grid-sm">
            {jugend.map((g) => <a class="team-kachel" href={`/mannschaften/${g.id}`}><strong>{g.data.name}</strong><span>{g.data.alter}</span></a>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack-lg">
      <div class="stack" style="gap:8px">
        <span class="eyebrow">Für Eltern &amp; neue Spieler</span>
        <h2>Dein Kind will Fußball spielen?</h2>
        <p class="lead">In drei Schritten zum ABC – ganz ohne PDF ausdrucken.</p>
      </div>
      <div class="grid">
        <div class="card stack" style="gap:10px"><span class="schritt-nr">1</span><h3>Team finden</h3><p class="muted">Unter Mannschaften siehst du je Altersklasse Trainer und Trainingszeiten.</p><a href="/mannschaften">Zu den Mannschaften →</a></div>
        <div class="card stack" style="gap:10px"><span class="schritt-nr">2</span><h3>Probetraining anfragen</h3><p class="muted">Kurzes Online-Formular – das Trainerteam meldet sich bei dir.</p><a href="/jugend/probetraining">Zum Formular →</a></div>
        <div class="card stack" style="gap:10px"><span class="schritt-nr">3</span><h3>Mitglied werden</h3><p class="muted">Mitgliedsantrag, Beitragsordnung und alle Infos auf einer Seite.</p><a href="/mitglied-werden">Mitglied werden →</a></div>
      </div>
    </div>
  </section>

  <section class="section section-sand">
    <div class="wrap row" style="gap:40px;align-items:center">
      <div class="stack" style="flex:1 1 380px">
        <span class="eyebrow">Ausbildungskonzept</span>
        <h2>So bilden wir aus</h2>
        <p class="muted" style="font-size:18px">Vom Bambini bis zur A-Jugend nach einer gemeinsamen Spielphilosophie – mit klarer Perspektive für jeden Spieler.</p>
        <a href="/jugend">Unsere Jugendarbeit →</a>
      </div>
      <div style="flex:1 1 520px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px">
        {['Perspektive', 'Spielnahe Ausbildung', 'Spielphilosophie', 'Intensität'].map((t) => (
          <div class="card" style="border-top:3px solid var(--gold)"><h3 class="display" style="font-size:clamp(20px,5vw,26px);font-weight:700;overflow-wrap:anywhere">{t}</h3></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack" style="align-items:center;text-align:center">
      <span class="eyebrow">Partner</span>
      <h2>Danke an unsere Sponsoren</h2>
      <p class="muted">Ohne sie wäre Jugendfußball in dieser Form nicht möglich.</p>
      <div class="row" style="justify-content:center"><a href="/sponsoren" class="btn btn-rot">Sponsoren &amp; Partner werden</a></div>
    </div>
  </section>
</Base>
