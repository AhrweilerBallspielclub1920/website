/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://*.fussball.de; script-src 'self' 'unsafe-inline' https://*.fussball.de; font-src 'self' https://*.fussball.de; connect-src 'self' https://*.fussball.de; frame-src https://*.fussball.de https://www.openstreetmap.org; form-action 'self'; base-uri 'self'; frame-ancestors 'none'
  # VORSCHAU: beim Go-live die nächste Zeile löschen und robots.txt anpassen
  X-Robots-Tag: noindex, nofollow

/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://unpkg.com; worker-src 'self' blob:; font-src 'self' data: https:; connect-src 'self' data: blob: https://api.github.com https://api.netlify.com https://*.githubusercontent.com https://www.githubstatus.com https://unpkg.com; frame-ancestors 'none'
  Cache-Control: no-store

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
